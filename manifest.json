{
  "manifest_version": 3,
  "name": "Kyara Scripts",
  "version": "1.0.4",
  "description": "Lance des scripts sur kyara.games depuis des boutons, avec réglages et aperçu avant exécution.",
  "permissions": ["storage"],
  "host_permissions": ["https://kyara.games/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Kyara Scripts",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://kyara.games/*"],
      "run_at": "document_idle",
      "js": [
        "core/kit.js",
        "scripts/proposer-offres.js",
        "scripts/encheres-concurrentiel.js",
        "scripts/preparer-echange.js",
        "ui/styles.js",
        "ui/content.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kyara-scripts@local",
      "strict_min_version": "125.0"
    }
  }
}
